 int Agc::init(IPAContext &context, const ValueNode &tuningData)
 {
+	/*
+	 * Optional: the longest frame duration, in microseconds, the AGC may
+	 * use in low light by lengthening the sensor frame (vertical
+	 * blanking). 0 or absent keeps the fixed default frame length.
+	 */
+	maxFrameDuration_ = std::chrono::microseconds(
+		tuningData["maxFrameDuration"].get<uint32_t>(0));
+
 	return agc_.init(tuningData, context.camHelper.get(), {
 		.sensorInfo = context.sensorInfo,
 		.sensorControls = context.sensorControls,
@@ -58,11 +73,78 @@ int Agc::init(IPAContext &context, const ValueNode &tuningData)
 
 int Agc::configure(IPAContext &context, [[maybe_unused]] const IPAConfigInfo &configInfo)
 {
-	return agc_.configure(context.configuration.agc, context.activeState.agc, {
+	int ret = agc_.configure(context.configuration.agc, context.activeState.agc, {
 		.sensorInfo = context.sensorInfo,
 		.sensorControls = context.sensorControls,
 		.ctrlMap = context.ctrlMap,
 	});
+	if (ret)
+		return ret;
+
+	context.configuration.vblank = {};
+
+	if (maxFrameDuration_ == utils::Duration(0))
+		return 0;
+
+	const auto vblankInfo = context.sensorControls.find(V4L2_CID_VBLANK);
+	const auto exposureInfo = context.sensorControls.find(V4L2_CID_EXPOSURE);
+	if (vblankInfo == context.sensorControls.end() ||
+	    exposureInfo == context.sensorControls.end()) {
+		LOG(IPASoftIspExposure, Warning)
+			<< "maxFrameDuration set but the sensor has no VBLANK control";
+		return 0;
+	}
+
+	const int32_t vblankMin = vblankInfo->second.min().get<int32_t>();
+	const int32_t vblankMax = vblankInfo->second.max().get<int32_t>();
+	const int32_t vblankDef = vblankInfo->second.def().get<int32_t>();
+	const int32_t exposureMax = exposureInfo->second.max().get<int32_t>();
+	const int32_t height = context.sensorInfo.outputSize.height;
+
+	/*
+	 * The sensor reports its exposure limit for the default frame length,
+	 * which gives the margin between frame length and exposure.
+	 */
+	const int32_t margin = vblankDef + height - exposureMax;
+	if (margin < 1 || margin > 64) {
+		LOG(IPASoftIspExposure, Warning)
+			<< "Unexpected exposure margin " << margin
+			<< " lines, keeping the fixed frame length";
+		return 0;
+	}
+
+	agc::Session &session = context.configuration.agc;
+	agc::ActiveState &state = context.activeState.agc;
+	const utils::Duration defFrameDuration = (height + vblankDef) * session.lineDuration;
+	const utils::Duration maxFrameDuration =
+		std::clamp(maxFrameDuration_, defFrameDuration, session.maxFrameDuration);
+
+	const utils::Duration maxExposureTime = maxFrameDuration - margin * session.lineDuration;
+	session.maxExposureTime = std::max(session.maxExposureTime, maxExposureTime);
+
+	/*
+	 * Default to the sensor's default frame length as the shortest frame,
+	 * and to the tuning file's bound as the longest. Applications can
+	 * still change both through FrameDurationLimits.
+	 */
+	state.minFrameDuration = defFrameDuration;
+	state.maxFrameDuration = maxFrameDuration;
+
+	const ControlInfo &exposureTime = context.ctrlMap[&controls::ExposureTime];
+	context.ctrlMap[&controls::ExposureTime] = ControlInfo{
+		exposureTime.min().get<int32_t>(),
+		static_cast<int32_t>(session.maxExposureTime.get<std::micro>()),
+		exposureTime.def().get<int32_t>(),
+	};
+
+	context.configuration.vblank = { true, vblankMin, vblankMax, margin };
+
+	LOG(IPASoftIspExposure, Info)
+		<< "Frame length control: frame duration up to " << maxFrameDuration
+		<< ", exposure time up to " << session.maxExposureTime
+		<< " (margin " << margin << " lines)";
+
+	return 0;
 }
 
