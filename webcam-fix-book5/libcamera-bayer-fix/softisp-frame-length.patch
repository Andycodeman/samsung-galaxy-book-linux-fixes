diff --git a/src/ipa/softisp/softisp.cpp b/src/ipa/softisp/softisp.cpp
index 00249a3..3f32d0c 100644
--- a/src/ipa/softisp/softisp.cpp
+++ b/src/ipa/softisp/softisp.cpp
@@ -256,6 +256,24 @@ void IPASoftIsp::processStats(const uint32_t frame,
 	ControlList ctrls(context_.sensorControls);
 	agc::prepareControls(ctrls, context_.camHelper.get(),
 			     frameContext.agc.exposure, frameContext.agc.gain);
+
+	/*
+	 * Lengthen the frame only as much as the exposure needs, and never
+	 * below the shortest frame duration allowed.
+	 */
+	const auto &vblankConfig = context_.configuration.vblank;
+	if (vblankConfig.enabled) {
+		const agc::Session &session = context_.configuration.agc;
+		const int32_t height = context_.sensorInfo.outputSize.height;
+		const int32_t minFrameLines =
+			frameContext.agc.minFrameDuration / session.lineDuration;
+		int32_t vblank = std::max<int32_t>(minFrameLines - height,
+						   static_cast<int32_t>(frameContext.agc.exposure) +
+						   vblankConfig.margin - height);
+		vblank = std::clamp(vblank, vblankConfig.min, vblankConfig.max);
+		ctrls.set(V4L2_CID_VBLANK, vblank);
+	}
+
 	setSensorControls.emit(ctrls);
 }
 
