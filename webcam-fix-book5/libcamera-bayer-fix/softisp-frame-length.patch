@@ -103,6 +185,26 @@ void Agc::process(IPAContext &context,
 	} else {
 		agc_.process(context.configuration.agc, context.activeState.agc, frameContext.agc, {}, metadata);
 	}
+
+	/*
+	 * With frame length control, report the frame length this frame had:
+	 * long enough for its exposure, and no shorter than the shortest
+	 * frame duration allowed.
+	 */
+	const auto &vblankConfig = context.configuration.vblank;
+	if (vblankConfig.enabled) {
+		const agc::Session &session = context.configuration.agc;
+		const int32_t height = context.sensorInfo.outputSize.height;
+		const int32_t minFrameLines =
+			frameContext.agc.minFrameDuration / session.lineDuration;
+		int32_t vblank = std::max<int32_t>(minFrameLines - height,
+						   static_cast<int32_t>(frameContext.sensor.exposure) +
+						   vblankConfig.margin - height);
+		vblank = std::clamp(vblank, vblankConfig.min, vblankConfig.max);
+		const utils::Duration frameDuration = (height + vblank) * session.lineDuration;
+		metadata.set(controls::FrameDuration,
+			     static_cast<int64_t>(frameDuration.get<std::micro>()));
+	}
 }
 
